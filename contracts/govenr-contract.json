{
  "$format_version": "REPLACE_WITH_VALUE_FROM_yappr-social-contract.json",
  "$schema": "https://schema.dash.org/dpp-0-4/json-schema/dash-contract/v1",
  "version": 1,
  "ownerId": "REPLACE_WITH_YOUR_TESTNET_IDENTITY_ID",
  "documents": {
    "proposalContent": {
      "type": "object",
      "description": "The human-readable content of an on-chain proposal, hosted on Platform so it can never be lost with a server. proposalHash links it to the immutable L1 governance object.",
      "mutable": true,
      "indices": [
        {
          "name": "ownerProposal",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "proposalHash": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "byProposal",
          "properties": [
            {
              "proposalHash": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "properties": {
        "proposalHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "description": "L1 governance object hash this content belongs to",
          "position": 0
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "description": "Display title (mirror of the L1 object name where possible)",
          "position": 1
        },
        "body": {
          "type": "string",
          "maxLength": 20000,
          "description": "Full proposal description, markdown",
          "position": 2
        },
        "milestones": {
          "type": "array",
          "byteArray": true,
          "maxItems": 4096,
          "position": 3,
          "description": "Deliverables or milestones as newline-separated lines, UTF-8 encoded bytes"
        },
        "reportRefs": {
          "type": "array",
          "byteArray": true,
          "maxItems": 4096,
          "position": 4,
          "description": "References to delivery reports (URLs or document ids), newline-separated, UTF-8 encoded bytes"
        }
      },
      "required": [
        "proposalHash",
        "title"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "description": "Sign-to-own record: proves the claiming identity (document owner) controls the private key of the proposal's on-chain payment address. Authorizes the claimant to author proposalContent for this proposalHash. Immutable evidence: the challenge, the signature, and the verified address (payout or collateral) are stored so anyone can independently re-verify against chain data.",
      "mutable": false,
      "indices": [
        {
          "name": "byProposal",
          "properties": [
            {
              "proposalHash": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "ownerClaims",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "properties": {
        "proposalHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "description": "L1 governance object hash being claimed",
          "position": 0
        },
        "verifiedAddress": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40,
          "description": "The chain-sourced address the signature was verified against: the proposal payout address OR the collateral (fee) address",
          "position": 1
        },
        "challenge": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512,
          "description": "The exact message that was signed: govenr-claim:<proposalHash>:<identityId>:<nonce>",
          "position": 2
        },
        "signature": {
          "type": "string",
          "minLength": 20,
          "maxLength": 128,
          "description": "Base64 signed message produced by the payout address key (Dash Core signmessage)",
          "position": 3
        }
      },
      "required": [
        "proposalHash",
        "verifiedAddress",
        "challenge",
        "signature"
      ],
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "description": "A discussion comment on a proposal. One thread per proposal; parentId nests replies.",
      "mutable": false,
      "indices": [
        {
          "name": "byProposal",
          "properties": [
            {
              "proposalHash": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "properties": {
        "proposalHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "description": "L1 governance object hash being discussed",
          "position": 0
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Comment text",
          "position": 1
        },
        "parentId": {
          "type": "string",
          "maxLength": 64,
          "description": "Document id of the comment this replies to (empty/absent = top-level)",
          "position": 2
        }
      },
      "required": [
        "proposalHash",
        "body"
      ],
      "additionalProperties": false
    },
    "proposalReview": {
      "type": "object",
      "description": "A reviewer's public evaluation of a proposal: stance plus reasoning. Exactly one review per identity per proposal (unique index); edits replace via document update.",
      "mutable": true,
      "indices": [
        {
          "name": "ownerProposal",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "proposalHash": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "byProposal",
          "properties": [
            {
              "proposalHash": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "properties": {
        "proposalHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "description": "L1 governance object hash being reviewed",
          "position": 0
        },
        "stance": {
          "type": "string",
          "pattern": "^(support|concern|neutral)$",
          "description": "The reviewer's public stance",
          "position": 1,
          "maxLength": 16
        },
        "body": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4000,
          "description": "Reasoning behind the stance",
          "position": 2
        },
        "mnoVerified": {
          "type": "boolean",
          "description": "Reserved for v1.1: true after operator-key attestation links this identity to a masternode. Always false in v1.",
          "position": 3
        }
      },
      "required": [
        "proposalHash",
        "stance"
      ],
      "additionalProperties": false
    },
    "tipReceipt": {
      "type": "object",
      "description": "Public receipt for a DASH tip sent to a review or comment. The payment itself moves on L1 (InstantSend); this document is the visible, queryable record — tips as public signal, not private transfers. $ownerId is the tipper.",
      "mutable": false,
      "indices": [
        {
          "name": "ownerTx",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "txid": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "byDoc",
          "properties": [
            {
              "docRef": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "properties": {
        "docRef": {
          "type": "string",
          "pattern": "^(review|comment):[A-Za-z0-9_-]{1,64}$",
          "maxLength": 96,
          "description": "What was tipped, as '<type>:<documentId>'",
          "position": 0
        },
        "toId": {
          "type": "string",
          "maxLength": 64,
          "description": "Identity id of the recipient (reviewer/commenter)",
          "position": 1
        },
        "amountDash": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "description": "Tip amount in DASH",
          "position": 2
        },
        "txid": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64,
          "description": "L1 transaction id of the payment",
          "position": 3
        }
      },
      "required": [
        "docRef",
        "toId",
        "amountDash",
        "txid"
      ],
      "additionalProperties": false
    }
  }
}